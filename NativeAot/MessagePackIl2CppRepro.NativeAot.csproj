<Project Sdk="Microsoft.NET.Sdk">
  <!-- The probe as a .NET 10 NativeAOT console app: the catalog, Ping and AllMessages from Assets/Scripts, the same steps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Messages.g.cs" Link="Catalog/Messages.g.cs" />
    <Compile Include="../Assets/Scripts/Ping.cs" Link="Catalog/Ping.cs" />
    <Compile Include="../Assets/Scripts/AllMessages.g.cs" Link="Catalog/AllMessages.g.cs" />
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
</Project>
