<Project Sdk="Microsoft.NET.Sdk">
  <!-- The probe as a .NET 10 NativeAOT console app: the catalog, Ping and AllMessages from Assets/Scripts, the same steps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <DefaultItemExcludes>$(DefaultItemExcludes);WarmUp/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Messages.g.cs" Link="Catalog/Messages.g.cs" />
    <Compile Include="../Assets/Scripts/Ping.cs" Link="Catalog/Ping.cs" />
    <Compile Include="../Assets/Scripts/AllMessages.g.cs" Link="Catalog/AllMessages.g.cs" />
    <ProjectReference Include="WarmUp/Repro.WarmUp.csproj" />
    <!-- PolyType directly as well: Nerdbank.MessagePack's dependency on it excludes the source generator. -->
    <PackageReference Include="Nerdbank.MessagePack" Version="1.4.104" />
    <PackageReference Include="PolyType" Version="1.4.1" />
  </ItemGroup>
</Project>
